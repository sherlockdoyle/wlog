---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import DevScript from '../../components/DevScript.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Tags from '../../components/Tags.astro';

type Props = CollectionEntry<'blog'> & { cover?: ImageMetadata };
const {
  data: { title, summary, tags, level, publishDate, updatedDate, katexMacros },
  filePath,
  cover,
} = Astro.props;

let seed = 0;
for (let i = 0; i < title.length; ++i) seed = (seed * 31 + title.charCodeAt(i)) % 2147483647;
function random() {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
}

const colors = Array.from({ length: 6 }, (_, i) => `var(--data-c${i + 1})`).sort(() => random() - 0.5);

const patternBase = colors[0];
const patternGrad = Array.from({ length: 5 }, (_, i) => {
  const color = colors[i + 1];
  const x = Math.floor(random() * 100),
    y = Math.floor(random() * 100);
  const size = Math.floor(random() * 40 + 40);
  return `radial-gradient(circle at ${x}% ${y}%, ${color}, transparent ${size}%)`;
}).join(',');
---

<main>
  <article>
    <header>
      {
        cover ? (
          <Image src={cover} alt={summary} />
        ) : (
          <div class='pattern' style={{ backgroundColor: patternBase, backgroundImage: patternGrad }} />
        )
      }
      <div class='overlay'></div>

      <div class='header-actions'>
        <a href={`https://github.com/sherlockdoyle/wlog/blob/main/${filePath}`} target='_blank'>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='lucide lucide-code'
          >
            <path d='m16 18 6-6-6-6'></path>
            <path d='m8 6-6 6 6 6'></path>
          </svg>
          See Source
        </a>
        <button>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='lucide lucide-share-2'
          >
            <circle cx='18' cy='5' r='3'></circle>
            <circle cx='6' cy='12' r='3'></circle>
            <circle cx='18' cy='19' r='3'></circle>
            <line x1='8.59' x2='15.42' y1='13.51' y2='17.49'></line>
            <line x1='15.41' x2='8.59' y1='6.51' y2='10.49'></line></svg
          >
          Share
        </button>
      </div>

      <div class='header-content'>
        <div>
          <FormattedDate date={publishDate} />{
            updatedDate && (
              <span>
                Updated on <FormattedDate date={updatedDate} />
              </span>
            )
          }
        </div>
        <h1>{title}</h1>
        <Tags {tags} {level} />
      </div>
    </header>

    <div class='post-content'>
      <slot />
    </div>
  </article>
</main>

{import.meta.env.DEV && <DevScript macros={katexMacros} />}

<script>
  document.querySelector<HTMLButtonElement>('.header-actions>button')!.addEventListener('click', () => {
    const data = {
      title: document.querySelector<HTMLMetaElement>(`meta[property="og:title"]`)?.content,
      text: document.querySelector<HTMLMetaElement>(`meta[property="og:description"]`)?.content,
      url: window.location.origin + window.location.pathname,
    } satisfies ShareData;
    if (navigator.share && navigator.canShare(data)) navigator.share(data);
    else {
      navigator.clipboard.writeText(data.url);
      alert('Link copied to clipboard!');
    }
  });
</script>

<style>
  @media (width > 112rem) {
    :global(#logo-menu) {
      cursor: auto !important;
      box-shadow: none !important;
      border-radius: 0 var(--header-radius) 0 0 !important;

      & > :global(#logo) {
        & .o {
          d: revert-layer !important;
        }
        & .a {
          stroke-width: 10px !important;
          d: revert-layer !important;
        }
        & .p {
          stroke: var(--data-c1) !important;
          d: revert-layer !important;
        }
      }
    }
    :global(#postnav-popover) {
      display: flex;
    }
  }

  main {
    margin: 0 auto;
    width: 100%;
    max-width: 64rem;

    & > article {
      width: 100%;

      & > header {
        display: flex;
        position: relative;
        flex-direction: column;
        justify-content: space-between;
        gap: 3rem;
        margin-bottom: 3rem;
        padding: 0 2rem 3rem;
        min-height: 40vh;
        overflow: hidden;

        @media (max-width: 48rem) {
          padding: 0 1rem 2rem;
          min-height: 30vh;
        }

        & > :is(img, .pattern) {
          position: absolute;
          z-index: 0;
          inset: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        & > .overlay {
          position: absolute;
          z-index: 1;
          inset: 0;
          background:
            linear-gradient(to top in oklch, var(--bg), color-mix(in oklch, var(--bg), transparent 25%), transparent),
            radial-gradient(100% 100% at 100% 0, var(--bg), transparent 50%);
        }

        & > .header-actions {
          display: flex;
          justify-content: flex-end;
          align-items: center;
          gap: 1rem;
          z-index: 2;
          width: 100%;
          height: var(--header-size);

          & > :is(a, button) {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            border: none;
            background: none;
            padding: 0;
            color: var(--fg);
            font-weight: 500;
            font-size: 0.9rem;
            font-family: var(--sans);
            text-decoration: none;

            &:hover {
              border-bottom: 1px solid currentColor;
            }
            &:active {
              color: var(--link);
            }

            & > svg {
              width: 1.25rem;
            }
          }
        }

        & > .header-content {
          z-index: 2;
          font-family: var(--sans);

          & > div {
            font-weight: 500;
            font-size: 0.9rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;

            & > span {
              display: inline-block;
              margin-left: 1rem;
              color: color-mix(in oklch, var(--fg), transparent 5%);
            }
          }

          & > h1 {
            margin: 0.5rem 0 2rem 0;
            font-weight: 700;
            font-size: clamp(2rem, 5vw, 3.5rem);
            line-height: 1.1;
            text-wrap: balance;
          }
        }
      }

      & > .post-content {
        margin-inline: 1rem;
      }
    }
  }
</style>

<style is:global>
  .post-content {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.7;
    font-family: var(--serif);
    hyphens: auto;
    text-align: justify;

    @media (max-width: 48rem) {
      hyphens: none;
      text-align: left;
    }

    h2,
    h3,
    h4,
    h5,
    h6 {
      margin-block: 2em 0.75em;
      font-weight: 600;
      line-height: 1.3;
      font-family: var(--sans);
      text-align: left;
    }
    h2 {
      font-size: 1.75em;
    }
    h3 {
      font-size: 1.25em;
    }
    h4 {
      font-size: 1em;
    }
    h5,
    h6 {
      color: color-mix(in oklch, var(--fg), var(--bg) 10%);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    h5 {
      font-size: 0.875em;
    }
    h6 {
      font-size: 0.75em;
    }

    p {
      margin-bottom: 1.25em;

      code {
        border-radius: 0.25em;
        background: var(--bg-subtle);
        padding: 0 0.4em;
      }
    }

    sup {
      line-height: 0;

      a {
        padding: 0 0.2em;
      }
    }

    a {
      color: var(--link);
      text-decoration: none;

      &:hover {
        border-bottom: 1px dotted currentColor;
      }
      &:active {
        border-bottom: 1px solid currentColor;
      }
    }

    table {
      margin-inline: auto;
      margin-block: 2em;
      border-collapse: collapse;

      & :is(th, td) {
        padding: 0.5em 1.5em;
        text-align: left;
      }

      & th {
        border-top: 2px solid var(--fg);
        border-bottom: 1px solid var(--fg);
      }

      & tr:last-child td {
        border-bottom: 2px solid var(--fg);
      }
    }

    blockquote {
      margin: 1.5em 0;
      border-left: 0.2em solid var(--fg);
      padding: 0 1.5em;
      font-style: italic;
      text-align: left;

      &[data-alert] {
        border-color: var(--bqbc);

        &[data-show-type]::before {
          display: block;
          margin-bottom: 0.5em;
          content: attr(data-alert);
          color: var(--bqbc);
          font-weight: 700;
          font-size: 0.9em;
          font-family: var(--sans);
          letter-spacing: 0.05em;
          text-transform: capitalize;
        }

        p {
          margin-bottom: 0;
        }
      }

      &[data-alert='note'] {
        --bqbc: var(--data-c1);
      }
      &[data-alert='tip'] {
        --bqbc: var(--data-c4);
      }
      &[data-alert='important'] {
        --bqbc: var(--data-c3);
      }
      &[data-alert='warning'] {
        --bqbc: var(--data-c2);
      }
      &[data-alert='caution'] {
        --bqbc: var(--data-c5);
      }
    }

    pre,
    code {
      font-size: 0.9em;
      font-family: var(--mono);
      font-feature-settings:
        'liga' 1,
        'calt' 1;
      text-align: left;
    }

    pre {
      margin-block: 1.5em;
      border-radius: 0.325em;
      background-color: var(--code);
      padding: 1em;
      overflow-x: auto;
    }

    ul,
    ol {
      margin-block: 1em;
      padding-inline-start: 2em;

      & li {
        margin-bottom: 0.5em;
      }
    }

    .math-display {
      overflow-x: auto;
      scrollbar-width: none;

      /* display:flex;
    margin-left: -1em;
    &::before {
      display: block;
      flex: 0 0 1em;
      content: '';
    }
    .katex-display{
      flex:1;
    } */
    }

    .footnotes {
      margin-top: 4em;
      border-top: 1px dashed var(--fg);
      font-size: 0.9em;
      text-align: left;

      ol {
        padding-inline-start: 2em;

        & li {
          margin-bottom: 0.5em;
        }
      }
    }
  }
</style>
