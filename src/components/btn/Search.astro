---
import Link from '../Link.astro';
---

<Link class='btn-icon' href='/search' title='Search'>
  <svg
    xmlns='http://www.w3.org/2000/svg'
    viewBox='0 0 24 24'
    fill='none'
    stroke='currentColor'
    stroke-width='2'
    stroke-linecap='round'
    stroke-linejoin='round'
  >
    <path d='m21 21-4.34-4.34'></path>
    <circle cx='11' cy='11' r='8'></circle>
  </svg>
</Link>

<style>
  a {
    &:hover > svg {
      transform: scale(1.1);
    }
    &:active > svg {
      transform: scale(0.9);
      transition-duration: 0.1s;
    }
  }
</style>
